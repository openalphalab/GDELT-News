FROM rust:1.97.1-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY tests ./tests
RUN cargo test --locked && cargo build --release --locked

FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HOME=/data/hf-cache HF_HUB_DISABLE_TELEMETRY=1 HF_HUB_DISABLE_PROGRESS_BARS=1
WORKDIR /app
COPY requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt
COPY --from=build /build/target/release/gdelt-type1 /usr/local/bin/gdelt-type1
COPY --from=build /build/target/release/gdelt-export /usr/local/bin/gdelt-export
COPY scripts ./scripts
COPY deploy/dataset-card.md ./deploy/dataset-card.md
RUN python -m unittest discover -s scripts -p 'test_*.py' && mkdir /data && chown 10001:10001 /data
ARG CODE_REVISION=unknown
ENV GDELT_CODE_REVISION=$CODE_REVISION
USER 10001:10001
ENTRYPOINT ["python", "/app/scripts/worker.py"]
